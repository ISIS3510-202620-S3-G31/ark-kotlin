rules_version = '2';

// Version 3 de reglas de Ark (Sprint 3):
// - Soporte de birthDate (YYYY-MM-DD) para el registro de usuarios
// - Retrocompatibilidad con age para el subequipo de Flutter
// - Colecciones privadas actualizadas para Kotlin y Flutter
// - Foto de perfil opcional de Kotlin en users/{uid} (avatarId, avatarSource, photoUrl)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Optional profile picture saved by Kotlin so it shows on every device; Flutter does not write or read it
    // avatarId: preset avatar, avatarSource: 'preset' or 'photo', photoUrl: download URL in Storage (users/{uid}/avatar/)
    function isValidAvatar(data) {
      return (!('avatarId' in data) || (data.avatarId is string && data.avatarId.size() <= 40))
        && (!('avatarSource' in data) || data.avatarSource in ['preset', 'photo'])
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2048
              && data.photoUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')));
    }

    // Profile saved by register: name, email, and birthDate (or legacy age from flutter)
    // The profile picture fields are optional, so every profile valid before is still valid
    function isValidUser(data) {
      let profileKeys = data.keys().removeAll(['avatarId', 'avatarSource', 'photoUrl']);
      return (profileKeys.hasOnly(['name', 'birthDate', 'email']) ||
              profileKeys.hasOnly(['name', 'age', 'email']) ||
              profileKeys.hasOnly(['name', 'birthDate', 'age', 'email']))
        && isValidAvatar(data)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 254
        && (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() >= 8 && data.birthDate.size() <= 15))
        && (!('age' in data) || (data.age is int && data.age >= 0 && data.age <= 120));
    }

    match /users/{userId}/check_ins/{day} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/tool_feedback/{feedbackId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/recommendations/{recommendationId} {
      allow read, write: if isOwner(userId);
    }

    // Tools catalog: logged users can read, only the console can write
    match /tools/{toolId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);

      // Private data of each user
      // Flutter: photos, breathing_sessions, tear_entries, tool_sessions, stats, feedback, analytics_events
      // Kotlin: mood_checkins, photos, tool_interactions, stats_summary, useful_insights, tool_load_latency, screen_time, stats_daily_visits
      match /{collection}/{docId} {
        allow read, write: if isOwner(userId)
          && collection in ['photos', 'breathing_sessions', 'mood_checkins', 'tear_entries',
                            'tool_sessions', 'stats', 'feedback', 'stats_daily_visits',
                            'analytics_events',
                            'tool_interactions', 'stats_summary', 'useful_insights',
                            'tool_load_latency', 'screen_time'];
      }
    }
  }
}
